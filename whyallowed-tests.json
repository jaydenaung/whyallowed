  {
    "id": "V05",
    "name": "Unconditional Allow plus conditional Deny is CONDITIONAL",
    "expect": "CONDITIONAL",
    "action": {
      "a": "s3:GetObject",
      "c": "data",
      "lvl": "object"
    },
    "principal": {
      "kind": "self",
      "account": "111111111111",
      "arn": "arn:aws:iam::111111111111:role/Dev",
      "label": "Dev"
    },
    "P": {
      "iam": {
        "Statement": [
          {
            "Sid": "A",
            "Effect": "Allow",
            "Action": "s3:*",
            "Resource": "*"
          },
          {
            "Sid": "VpceOnly",
            "Effect": "Deny",
            "Action": "s3:*",
            "Resource": "*",
            "Condition": {
              "StringNotEquals": {
                "aws:SourceVpce": "vpce-0123"
              }
            }
          }
        ]
      }
    },
    "ctx": {
      "principalAccount": "111111111111",
      "myAccounts": [
        "111111111111"
      ]
    }
  },
