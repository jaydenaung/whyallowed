  {
    "id": "V17",
    "name": "NotPrincipal Deny in a resource policy spares the named principal",
    "expect": "ALLOW",
    "action": {
      "a": "s3:GetObject",
      "c": "data",
      "lvl": "object"
    },
    "principal": {
      "kind": "self",
      "account": "111111111111",
      "arn": "arn:aws:iam::111111111111:role/Admin",
      "label": "Admin"
    },
    "P": {
      "iam": {
        "Statement": [
          {
            "Sid": "A",
            "Effect": "Allow",
            "Action": "s3:*",
            "Resource": "*"
          }
        ]
      },
      "s3": {
        "Statement": [
          {
            "Sid": "D",
            "Effect": "Deny",
            "NotPrincipal": {
              "AWS": "arn:aws:iam::111111111111:role/Admin"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::b/*"
          }
        ]
      }
    },
    "ctx": {
      "principalAccount": "111111111111",
      "myAccounts": [
        "111111111111"
      ],
      "resourceType": "s3",
      "bucket": "b",
      "bucketAccount": "111111111111"
