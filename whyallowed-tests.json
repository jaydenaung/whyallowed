[
  {
    "id": "V01",
    "name": "Same-account :root in bucket policy is delegation, not a grant",
    "expect": "DENY",
    "action": {
      "a": "s3:GetObject",
      "c": "data",
      "lvl": "object"
    },
    "principal": {
      "kind": "self",
      "account": "111111111111",
      "arn": "arn:aws:iam::111111111111:role/Dev",
      "label": "Dev"
    },
    "P": {
      "iam": {
        "Statement": [
          {
            "Sid": "NoS3",
            "Effect": "Allow",
            "Action": "ec2:Describe*",
            "Resource": "*"
          }
        ]
      },
      "s3": {
        "Statement": [
          {
            "Sid": "RootDelegate",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111111111111:root"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::b/*"
          }
        ]
      }
    },
    "ctx": {
      "resourceType": "s3",
      "bucket": "b",
      "bucketAccount": "111111111111",
      "principalAccount": "111111111111",
      "myAccounts": [
        "111111111111"
      ]
    }
  },
